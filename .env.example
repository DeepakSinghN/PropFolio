# ==========================================
# PropFolio Environment Variables
# Duplicate this file as .env.local and fill in values
# ==========================================

# 1. Supabase (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Google Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# 3. Domain & Subdomain Configuration
# Local testing: localhost:3000
# Production: propfolio.co
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# 4. Meta WhatsApp Cloud API (For WhatsApp Bot)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=propfolio_secret_token_123

# 5. Payments (Razorpay / Stripe)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

